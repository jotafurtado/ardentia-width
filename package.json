{
  "name": "ardentia-width",
  "version": "1.0.0",
  "private": true,
  "description": "Obsidian plugin that expands a note or a single table to the full width of the pane.",
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "install:dev": "npm run build && node scripts/install-dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "esbuild": "0.28.2",
    "eslint": "^9.30.0",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "^1.8.7",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.35.1"
  }
}
